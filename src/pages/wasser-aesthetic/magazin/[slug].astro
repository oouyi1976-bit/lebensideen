---
import { ArrowLeft, ArrowRight, Check, Clock3, WavesHorizontal } from "@lucide/astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { articles } from "../../../data/wasser-aesthetic";

export function getStaticPaths() {
  return articles.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

const { article } = Astro.props;
const currentIndex = articles.findIndex((item) => item.slug === article.slug);
const previous = articles[(currentIndex - 1 + articles.length) % articles.length];
const next = articles[(currentIndex + 1) % articles.length];
const canonical = `/wasser-aesthetic/magazin/${article.slug}/`;
const description = article.intro;

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Startseite",
        item: "https://lieblingsideen.de/",
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Wasser Aesthetic",
        item: "https://lieblingsideen.de/wasser-aesthetic/",
      },
      {
        "@type": "ListItem",
        position: 3,
        name: article.title,
        item: `https://lieblingsideen.de${canonical}`,
      },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: article.title,
    description: article.intro,
    image: `https://lieblingsideen.de${article.image}`,
    author: {
      "@type": "Organization",
      name: "LieblingsIdeen",
    },
    publisher: {
      "@type": "Organization",
      name: "LieblingsIdeen",
    },
    mainEntityOfPage: `https://lieblingsideen.de${canonical}`,
  },
];
---

<BaseLayout
  title={`${article.title} | LieblingsIdeen`}
  description={description}
  canonical={canonical}
  image={article.image}
  imageAlt={article.alt}
  type="article"
  jsonLd={jsonLd}
>
  <article class="article-page">
    <header class="article-hero">
      <div class="article-hero-image">
        <img
          src={article.image}
          alt={article.alt}
          width="1200"
          height="800"
          fetchpriority="high"
          decoding="async"
        />
      </div>
      <div class="article-hero-copy">
        <nav class="breadcrumbs" aria-label="Brotkrümelnavigation">
          <a href="/wasser-aesthetic/">Wasser Aesthetic</a>
          <span aria-hidden="true">/</span>
          <a href="/wasser-aesthetic/#magazin">Magazin</a>
        </nav>
        <p class="eyebrow"><WavesHorizontal size={18} aria-hidden="true" /> LieblingsIdeen Ratgeber</p>
        <h1>{article.title}</h1>
        <p class="article-lead">{article.intro}</p>
        <span class="reading-time"><Clock3 size={17} aria-hidden="true" /> {article.readingTime}</span>
      </div>
    </header>

    <div class="article-content-shell">
      <div class="article-body">
        {
          article.sections.map((section) => (
            <section>
              <h2>{section.heading}</h2>
              {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
              {section.tips && (
                <ul class="tip-list">
                  {section.tips.map((tip) => (
                    <li><Check size={18} aria-hidden="true" /><span>{tip}</span></li>
                  ))}
                </ul>
              )}
            </section>
          ))
        }

        <aside class="article-callout" aria-label="Gestaltungstipp">
          <WavesHorizontal size={28} aria-hidden="true" />
          <div>
            <h2>Deine Wasser Aesthetic, dein Tempo</h2>
            <p>
              Beginne mit einem einzigen Lieblingsstück und beobachte, wie Licht, Farbe
              und Material in deinem Raum wirken. Gute Wohnideen dürfen langsam wachsen.
            </p>
          </div>
        </aside>

        <a class="button article-back-button" href="/wasser-aesthetic/#produkte">
          <ArrowLeft size={17} aria-hidden="true" />
          Zu den Wasser Aesthetic Favoriten
        </a>
      </div>

      <aside class="article-aside" aria-label="Mehr aus dem Magazin">
        <span class="section-kicker">Weiterlesen</span>
        <h2>Mehr Inspiration</h2>
        <a class="related-article" href={`/wasser-aesthetic/magazin/${previous.slug}/`}>
          <img src={previous.image} alt="" width="1200" height="800" loading="lazy" decoding="async" />
          <span>{previous.title}</span>
        </a>
        <a class="related-article" href={`/wasser-aesthetic/magazin/${next.slug}/`}>
          <img src={next.image} alt="" width="1200" height="800" loading="lazy" decoding="async" />
          <span>{next.title}</span>
        </a>
        <a class="text-link" href="/wasser-aesthetic/#magazin">
          Alle Ratgeber <ArrowRight size={16} aria-hidden="true" />
        </a>
      </aside>
    </div>
  </article>
</BaseLayout>
