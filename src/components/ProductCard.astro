---
import { Clock3, ExternalLink } from "@lucide/astro";
import type { Product } from "../data/wasser-aesthetic";

type Props = {
  product: Product;
  eager?: boolean;
};

const { product, eager = false } = Astro.props;
const linkAttrs = product.href
  ? {
      href: product.href,
      target: "_blank",
      rel: "nofollow sponsored noopener noreferrer",
    }
  : null;
---

<article class="product-card" data-product-card data-search-text={`${product.title} ${product.feature} ${product.categoryTitle}`.toLowerCase()}>
  {
    linkAttrs ? (
      <a class="product-image-link" {...linkAttrs} aria-label={`${product.title} bei Amazon ansehen`}>
        <img
          src={product.image}
          alt={product.alt}
          width="900"
          height="900"
          loading={eager ? "eager" : "lazy"}
          decoding="async"
        />
      </a>
    ) : (
      <div class="product-image-wrap">
        <img
          src={product.image}
          alt={product.alt}
          width="900"
          height="900"
          loading={eager ? "eager" : "lazy"}
          decoding="async"
        />
        <span class="placeholder-badge"><Clock3 size={13} aria-hidden="true" /> Link in Prüfung</span>
      </div>
    )
  }
  <div class="product-card-body">
    {
      linkAttrs ? (
        <h3><a {...linkAttrs}>{product.title}</a></h3>
      ) : (
        <h3>{product.title}</h3>
      )
    }
    <p>{product.feature}</p>
    {
      linkAttrs ? (
        <a class="button product-button" {...linkAttrs}>
          Bei Amazon ansehen
          <ExternalLink size={15} aria-hidden="true" />
        </a>
      ) : (
        <span class="button product-button is-disabled" aria-disabled="true">
          Amazon-Link folgt
        </span>
      )
    }
  </div>
</article>
