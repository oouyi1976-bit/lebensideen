---
import {
  ArrowRight,
  ChevronRight,
  Droplet,
  Flower2,
  Info,
  LampDesk,
  Leaf,
  Shell,
  Sparkles,
  WavesHorizontal,
} from "@lucide/astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProductCard from "../../components/ProductCard.astro";
import { articles, categoryOrder, products } from "../../data/wasser-aesthetic";

const title = "Wasser Aesthetic: Deko, Wasserlampen und maritime Wohnideen";
const description =
  "Entdecke Wasser-Aesthetic-Deko in Blau und Türkis, stilvolle Wasserlampen, Glasvasen, Zimmerbrunnen und maritime Wohnideen für ein entspanntes Zuhause.";
const favorites = products.filter((product) => product.favorite);
const remainingProducts = products.filter((product) => !product.favorite);
const categories = categoryOrder
  .map((slug) => ({
    slug,
    title: products.find((product) => product.category === slug)?.categoryTitle ?? slug,
    products: remainingProducts.filter((product) => product.category === slug),
  }))
  .filter((category) => category.products.length > 0);

const breadcrumbs = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Startseite",
      item: "https://lieblingsideen.de/",
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Wasser Aesthetic",
      item: "https://lieblingsideen.de/wasser-aesthetic/",
    },
  ],
};

const sidebarCategories = [
  { label: "Deko in Blau & Türkis", href: "#glasvasen", icon: Droplet },
  { label: "Wasserlampen & Lichter", href: "#wasserlicht", icon: LampDesk },
  { label: "Muscheln & Meeresdeko", href: "#meeresdeko", icon: Shell },
  { label: "Wellness & Entspannung", href: "#wellness", icon: Sparkles },
  { label: "Garten & Balkon am Wasser", href: "#garten", icon: Leaf },
];
---

<BaseLayout
  title={title}
  description={description}
  canonical="/wasser-aesthetic/"
  image="/images/wasser-aesthetic/og-wasser-aesthetic.avif"
  jsonLd={breadcrumbs}
>
  <section class="hero">
    <div class="hero-media" aria-hidden="true">
      <img
        src="/images/wasser-aesthetic/hero-wasser-aesthetic.avif"
        alt=""
        width="1600"
        height="1067"
        fetchpriority="high"
        decoding="async"
        data-pin-media="/images/wasser-aesthetic/pinterest-wasser-aesthetic.avif"
        data-pin-description="Wasser Aesthetic: Deko, Wasserlampen und maritime Wohnideen von LieblingsIdeen"
      />
    </div>
    <div class="hero-overlay"></div>
    <div class="hero-inner">
      <div class="hero-copy">
        <p class="eyebrow"><WavesHorizontal size={18} aria-hidden="true" /> Wohnen im Fluss</p>
        <h1>Wasser Aesthetic</h1>
        <p class="hero-subtitle">
          Beruhigende Farben, fließende Formen und die Magie des Wassers – so bringst du
          Leichtigkeit und Harmonie in dein Zuhause.
        </p>
        <ul class="benefits" aria-label="Vorteile">
          <li><Droplet aria-hidden="true" /><span>Inspiriert von<br />Wasser &amp; Meer</span></li>
          <li><Shell aria-hidden="true" /><span>Für ein beruhigendes<br />Zuhause</span></li>
          <li><WavesHorizontal aria-hidden="true" /><span>Deko, Accessoires &amp;<br />besondere Highlights</span></li>
        </ul>
        <a class="button hero-button" href="#produkte">
          Jetzt entdecken
          <ArrowRight size={17} aria-hidden="true" />
        </a>
      </div>
    </div>
  </section>

  <div class="page-shell">
    <aside class="affiliate-note" id="transparenz" aria-label="Affiliate-Hinweis">
      <Info size={17} aria-hidden="true" />
      <span>Als Amazon-Partner verdiene ich an qualifizierten Verkäufen.</span>
    </aside>

    <div class="search-result-note" data-search-result-note hidden></div>

    <div class="content-layout">
      <div class="content-main">
        <section class="favorites-section" id="produkte" aria-labelledby="favoriten-heading">
          <div class="section-heading-row">
            <div>
              <p class="section-kicker">Sorgfältig kuratiert</p>
              <h2 id="favoriten-heading">Unsere Wasser Aesthetic Favoriten <WavesHorizontal size={25} aria-hidden="true" /></h2>
            </div>
            <p>30 Ideen für ruhige Räume</p>
          </div>

          <div class="favorites-grid">
            {favorites.map((product) => <ProductCard product={product} eager />)}
          </div>

          <div class="show-all-wrap">
            <button class="outline-button" type="button" aria-expanded="false" aria-controls="product-catalog" data-show-products>
              <span>Alle Wasser Aesthetic Produkte anzeigen</span>
              <ChevronRight size={18} aria-hidden="true" />
            </button>
          </div>
        </section>

        <section class="product-catalog" id="product-catalog" aria-label="Alle Wasser Aesthetic Produkte" hidden>
          <div class="catalog-intro">
            <p class="section-kicker">Nach Bereichen entdecken</p>
            <h2>Wasser Deko für jeden Lieblingsplatz</h2>
            <p>
              Von der Wasserlampe über maritime Dekoration bis zur Wellness Deko:
              Die Auswahl ist nach Einsatzbereich geordnet. Ungeprüfte Angebote bleiben
              bewusst ohne Kauf-Link.
            </p>
          </div>
          {
            categories.map((category) => (
              <section class="category-section" id={category.slug} aria-labelledby={`${category.slug}-heading`}>
                <div class="category-heading">
                  <h3 id={`${category.slug}-heading`}>{category.title}</h3>
                  <span>{category.products.length} {category.products.length === 1 ? "Idee" : "Ideen"}</span>
                </div>
                <div class="catalog-grid">
                  {category.products.map((product) => <ProductCard product={product} />)}
                </div>
              </section>
            ))
          }
        </section>

        <section class="magazine-section" id="magazin" aria-labelledby="magazin-heading">
          <div class="section-heading-row">
            <div>
              <p class="section-kicker">Räume mit Gefühl gestalten</p>
              <h2 id="magazin-heading">Magazin &amp; Inspiration</h2>
            </div>
            <Flower2 size={30} stroke-width={1.4} aria-hidden="true" />
          </div>
          <div class="article-grid">
            {
              articles.map((article) => (
                <article class="article-card">
                  <a href={`/wasser-aesthetic/magazin/${article.slug}/`} class="article-image-link" aria-label={`${article.title} lesen`}>
                    <img
                      src={article.image}
                      alt={article.alt}
                      width="1200"
                      height="800"
                      loading="lazy"
                      decoding="async"
                    />
                  </a>
                  <div class="article-card-body">
                    <span>{article.readingTime}</span>
                    <h3><a href={`/wasser-aesthetic/magazin/${article.slug}/`}>{article.title}</a></h3>
                    <p>{article.intro}</p>
                    <a class="text-link" href={`/wasser-aesthetic/magazin/${article.slug}/`}>
                      Artikel lesen <ArrowRight size={16} aria-hidden="true" />
                    </a>
                  </div>
                </article>
              ))
            }
          </div>
        </section>
      </div>

      <aside class="sidebar" aria-label="Weitere Inspiration">
        <section class="sidebar-card category-list">
          <h2>Beliebte Kategorien</h2>
          <nav aria-label="Beliebte Kategorien">
            {
              sidebarCategories.map(({ label, href, icon: Icon }) => (
                <a href={href}>
                  <Icon size={20} stroke-width={1.55} aria-hidden="true" />
                  <span>{label}</span>
                  <ChevronRight size={17} aria-hidden="true" />
                </a>
              ))
            }
          </nav>
        </section>

        <section class="sidebar-card inspiration-card">
          <h2>Inspiration gefällig?</h2>
          <img
            src="/images/wasser-aesthetic/produkt-laternen.avif"
            alt="Blaue Laternen mit Kerzen auf einer hellen Terrasse"
            width="900"
            height="900"
            loading="lazy"
            decoding="async"
          />
          <p>Entdecke viele Ideen, DIYs und Tipps für dein Zuhause im Wasser-Look.</p>
          <a class="button" href="#magazin">
            Zur Inspirationswelt <ArrowRight size={16} aria-hidden="true" />
          </a>
        </section>

        <section class="sidebar-card calm-card">
          <WavesHorizontal size={28} stroke-width={1.4} aria-hidden="true" />
          <h2>Unser Stilversprechen</h2>
          <p>Ruhige Farben, klare Auswahl und Wohnideen, die auch morgen noch schön wirken.</p>
        </section>
      </aside>
    </div>
  </div>

  <script>
    const showButton = document.querySelector("[data-show-products]");
    const catalog = document.querySelector("#product-catalog");

    const setCatalog = (open: boolean, scroll = false) => {
      if (!(catalog instanceof HTMLElement) || !(showButton instanceof HTMLButtonElement)) return;
      catalog.hidden = !open;
      showButton.setAttribute("aria-expanded", String(open));
      const label = showButton.querySelector("span");
      if (label) label.textContent = open
        ? "Produktauswahl wieder einklappen"
        : "Alle Wasser Aesthetic Produkte anzeigen";
      showButton.classList.toggle("is-open", open);
      if (scroll && open) catalog.scrollIntoView({ behavior: "smooth", block: "start" });
    };

    showButton?.addEventListener("click", () => {
      const open = showButton.getAttribute("aria-expanded") !== "true";
      setCatalog(open, open);
    });

    document.querySelectorAll('a[href^="#"]').forEach((link) => {
      link.addEventListener("click", () => {
        const href = link.getAttribute("href");
        if (!href || href === "#") return;
        const target = document.querySelector(href);
        if (target?.closest("#product-catalog")) setCatalog(true);
      });
    });

    const params = new URLSearchParams(window.location.search);
    const query = params.get("suche")?.trim().toLocaleLowerCase("de");
    const resultNote = document.querySelector("[data-search-result-note]");

    if (query) {
      setCatalog(true);
      let count = 0;
      document.querySelectorAll("[data-product-card]").forEach((card) => {
        if (!(card instanceof HTMLElement)) return;
        const matches = card.dataset.searchText?.includes(query) ?? false;
        card.hidden = !matches;
        if (matches) count += 1;
      });
      document.querySelectorAll(".category-section").forEach((section) => {
        if (!(section instanceof HTMLElement)) return;
        const hasVisible = Array.from(section.querySelectorAll("[data-product-card]")).some(
          (card) => card instanceof HTMLElement && !card.hidden,
        );
        section.hidden = !hasVisible;
      });
      if (resultNote instanceof HTMLElement) {
        resultNote.hidden = false;
        resultNote.textContent = count
          ? `${count} ${count === 1 ? "Ergebnis" : "Ergebnisse"} für „${query}“`
          : `Keine Produkte für „${query}“ gefunden. Probiere einen allgemeineren Begriff.`;
      }
    }

    if (window.location.hash && document.querySelector(window.location.hash)?.closest("#product-catalog")) {
      setCatalog(true);
    }
  </script>
</BaseLayout>
