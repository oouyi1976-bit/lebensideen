---
import {
  ArrowDown,
  ArrowUpRight,
  Compass,
  Heart,
  Leaf,
  Sparkles,
} from "@lucide/astro";
import PortalLayout from "../layouts/PortalLayout.astro";

const title = "Lebensideen – Ideen, Inspiration und Empfehlungen";
const description =
  "Entdecke die Lebensideen-Themenwelten rund um Familie, Reisen, Wohnen, Finanzen, Genuss und besondere Trends.";

const projects = [
  {
    name: "Wasser Aesthetic",
    category: "Wohnen & Deko",
    description:
      "Beruhigende Farben, fließende Formen und ausgewählte Wohnideen in Blau und Türkis.",
    href: "https://wasser-aesthetic.pages.dev/",
    image: "/images/wasser-aesthetic/hero-wasser-aesthetic.avif",
    alt: "Blaue Glasvase, Muschelschale und Wasserlicht in einer hellen Wohnszene",
    accent: "ocean",
    topics: ["Wasserlicht", "Meeresdeko", "Wellness"],
  },
  {
    name: "BabyReiseHelfer",
    category: "Familie & Reisen",
    description:
      "Praktische Reisehilfen, durchdachte Packtipps und entspannte Ideen für unterwegs mit Baby.",
    href: "https://babyreisehelfer.pages.dev/",
    image: "/images/portal/babyreisehelfer.webp",
    alt: "Hochwertige Babyausstattung für eine entspannte Zugreise",
    accent: "sage",
    topics: ["Packlisten", "Unterwegs", "Familienzeit"],
  },
  {
    name: "Finanzielle Freiheit Ratgeber",
    category: "Finanzen & Alltag",
    description:
      "Verständliche Impulse für bessere Geldentscheidungen, langfristige Ziele und mehr Überblick.",
    href: "https://finanzielle-freiheit-ratgeber.pages.dev/",
    image: "/images/portal/finanzielle-freiheit.webp",
    alt: "Ruhiger Arbeitsplatz mit Notizbuch, Sparglas und Münzen",
    accent: "forest",
    topics: ["Sparen", "Planen", "Vorsorge"],
  },
  {
    name: "Cocktailliebe",
    category: "Genuss & Rezepte",
    description:
      "Stilvolle Drinks, erprobte Rezepte und Inspiration für besondere Abende zu Hause.",
    href: "https://cocktailliebe.pages.dev/",
    image: "/images/portal/cocktailliebe.webp",
    alt: "Zwei elegante Cocktails mit Zitrusfrüchten und frischen Kräutern",
    accent: "amber",
    topics: ["Cocktails", "Rezepte", "Gastgeben"],
  },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Lebensideen Themenwelten",
  itemListElement: projects.map((project, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: project.name,
    url: project.href,
  })),
};
---

<PortalLayout title={title} description={description}>
  <header class="portal-header">
    <a class="portal-brand" href="/" aria-label="Lebensideen Startseite">
      <span>Lebensideen</span>
      <small>Ideen, Inspiration und Empfehlungen für deinen Alltag</small>
    </a>
    <nav aria-label="Hauptnavigation">
      <a href="#themenwelten">Themenwelten</a>
      <a href="#ueber-uns">Über Lebensideen</a>
    </nav>
  </header>

  <main id="main-content">
    <section class="portal-hero" aria-labelledby="hero-title">
      <div class="hero-orbit orbit-one" aria-hidden="true"></div>
      <div class="hero-orbit orbit-two" aria-hidden="true"></div>
      <div class="hero-content">
        <p class="eyebrow"><Sparkles size={17} aria-hidden="true" /> Alles an einem Ort</p>
        <h1 id="hero-title">Entdecke unsere Themenwelten</h1>
        <p>
          Von Reisen und Familie über Wohnen und Garten bis zu Cocktails, Finanzen und
          besonderen Trends – hier findest du alle Lebensideen-Projekte auf einen Blick.
        </p>
        <a class="hero-link" href="#themenwelten">
          Projekte entdecken <ArrowDown size={18} aria-hidden="true" />
        </a>
      </div>
      <div class="hero-notes" aria-label="Was Lebensideen auszeichnet">
        <div><Compass aria-hidden="true" /><span>Orientierung statt Überfluss</span></div>
        <div><Heart aria-hidden="true" /><span>Mit Sorgfalt ausgewählt</span></div>
        <div><Leaf aria-hidden="true" /><span>Ideen für deinen Alltag</span></div>
      </div>
    </section>

    <section class="projects-section" id="themenwelten" aria-labelledby="projects-heading">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Unsere Projekte</p>
          <h2 id="projects-heading">Was interessiert dich heute?</h2>
        </div>
        <p>Vier eigenständige Themenwelten – klar kuratiert und direkt erreichbar.</p>
      </div>

      <div class="project-grid">
        {
          projects.map((project) => (
            <article class={`project-card accent-${project.accent}`}>
              <a
                class="project-image"
                href={project.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${project.name} öffnen`}
              >
                <img
                  src={project.image}
                  alt={project.alt}
                  width={project.name === "Wasser Aesthetic" ? 1600 : 1400}
                  height={project.name === "Wasser Aesthetic" ? 1067 : 933}
                  loading="lazy"
                  decoding="async"
                />
                <span>{project.category}</span>
              </a>
              <div class="project-body">
                <h3>
                  <a href={project.href} target="_blank" rel="noopener noreferrer">
                    {project.name}
                  </a>
                </h3>
                <p>{project.description}</p>
                <ul aria-label={`Themen bei ${project.name}`}>
                  {project.topics.map((topic) => <li>{topic}</li>)}
                </ul>
                <a
                  class="project-button"
                  href={project.href}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Projekt entdecken <ArrowUpRight size={17} aria-hidden="true" />
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section class="about-section" id="ueber-uns" aria-labelledby="about-heading">
      <div>
        <p class="eyebrow">Lebensideen</p>
        <h2 id="about-heading">Inspiration, die zu deinem Leben passt</h2>
      </div>
      <p>
        Lebensideen bündelt eigenständige Ratgeber und Themenportale. Jede Themenwelt hat
        ihren eigenen Schwerpunkt, bleibt übersichtlich und führt dich ohne Umwege zu den
        passenden Inhalten.
      </p>
    </section>
  </main>

  <footer class="portal-footer">
    <div>
      <strong>Lebensideen</strong>
      <span>Ideen, Inspiration und Empfehlungen für deinen Alltag</span>
    </div>
    <span>© {new Date().getFullYear()} Lebensideen</span>
  </footer>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</PortalLayout>
